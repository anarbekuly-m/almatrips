---
import Base from '../../layouts/Base.astro';
import { t, localizePath, waLink, BRAND, type Lang } from '../../i18n/ui';
import type { Post } from '../../data/posts';

interface Props { lang: Lang; post: Post }
const { lang, post } = Astro.props;
const c = post[lang];
const path = `/blog/${post.slug}/`;
const site = (Astro.site?.href ?? 'https://almatrips.kz/').replace(/\/$/, '');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: c.title,
  description: c.metaDescription,
  image: site + post.image,
  datePublished: post.date,
  dateModified: post.date,
  inLanguage: lang === 'en' ? 'en' : 'ru',
  author: { '@type': 'Organization', name: BRAND, url: site },
  publisher: { '@type': 'Organization', name: BRAND, url: site },
  mainEntityOfPage: site + (lang === 'en' ? path : '/ru' + path),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: BRAND, item: site + localizePath(lang, '/') },
    { '@type': 'ListItem', position: 2, name: t(lang, 'nav.blog'), item: site + localizePath(lang, '/blog/') },
    { '@type': 'ListItem', position: 3, name: c.title },
  ],
};

const dateLabel = new Date(post.date).toLocaleDateString(lang === 'en' ? 'en-GB' : 'ru-RU', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---
<Base
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  path={path}
  image={post.image}
  schema={[articleSchema, breadcrumbSchema]}
>
  <section class="tour-hero">
    <div class="tour-hero-media slider">
      <div class="slider-track"><div class="slider-slide">
        <img src={post.image} alt={c.title} width="1280" height="720" />
      </div></div>
    </div>
    <div class="tour-hero-scrim" aria-hidden="true"></div>
    <div class="container tour-hero-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={localizePath(lang, '/')}>{BRAND}</a><span>/</span>
        <a href={localizePath(lang, '/blog/')}>{t(lang, 'nav.blog')}</a>
      </nav>
      <h1>{c.title}</h1>
      <div class="tour-meta-chips">
        <span class="chip">{dateLabel}</span>
        <span class="chip">{post.readMinutes} {lang === 'en' ? 'min read' : 'мин'}</span>
      </div>
    </div>
  </section>

  <div class="container post-layout">
    <article class="post-body">
      {c.body.map((b) =>
        b.t === 'h2' ? <h2>{b.text}</h2>
        : b.t === 'p' ? <p>{b.text}</p>
        : b.t === 'tip' ? <p class="post-tip">{b.text}</p>
        : <ul class="highlights-list">{b.items.map((i) => <li>{i}</li>)}</ul>
      )}

      <div class="post-cta">
        <h2 style="margin-top:0">{t(lang, 'cta.title')}</h2>
        <p>{t(lang, 'cta.sub')}</p>
        <div class="dest-nav" style="margin-top:18px; justify-content:flex-start">
          <a href={waLink(lang)} class="btn btn-wa" target="_blank" rel="noopener">{t(lang, 'cta.btn')}</a>
          <a href={localizePath(lang, '/group-tours/')} class="btn btn-outline">{t(lang, 'choose.group.cta')} →</a>
          <a href={localizePath(lang, '/private-tours/')} class="btn btn-outline">{t(lang, 'choose.private.cta')} →</a>
        </div>
      </div>
    </article>
  </div>
</Base>
